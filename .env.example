# Base de données
DATABASE_URL="postgresql://finza:finza@localhost:5432/finza?schema=public"

# Redis (cache, BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Stockage fichiers (S3-compatible / MinIO en local)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="finza-local"
S3_ACCESS_KEY_ID="finza"
S3_SECRET_ACCESS_KEY="finza123"

# Assistant IA (Gemini) — clé côté serveur uniquement, jamais exposée au frontend.
# Laisser GEMINI_API_KEY vide désactive l'assistant proprement (message clair côté app).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Paiement (agrégateur panafricain)
PAYMENT_PROVIDER="cinetpay"
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""

# Notifications
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
SENDGRID_API_KEY=""
SMS_PROVIDER_API_KEY=""

# App
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001"
