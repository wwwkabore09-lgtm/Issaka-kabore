# Base de données
DATABASE_URL="postgresql://finza:finza@localhost:5432/finza?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Assistant IA (Gemini) — clé côté serveur uniquement, jamais exposée au frontend.
# Laisser GEMINI_API_KEY vide désactive l'assistant proprement (message clair côté app).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Paiement (abonnement Premium) — prestataire pas encore choisi : ces clés génériques seront
# adaptées une fois l'API du prestataire connue (voir apps/api/src/premium). Laisser
# PAYMENT_API_KEY vide désactive l'abonnement payant proprement (message clair côté app).
PAYMENT_API_KEY=""
PAYMENT_SECRET_KEY=""
PAYMENT_BASE_URL=""

# Origines autorisées en CORS pour l'API, séparées par des virgules (ex: "https://app.finza.com").
# Laisser vide autorise toutes les origines — pratique en développement, à restreindre en
# production à l'URL réelle du frontend déployé.
CORS_ORIGIN=""

# App
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001"
