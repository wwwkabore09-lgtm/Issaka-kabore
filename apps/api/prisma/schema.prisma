// Schéma Prisma de Finza.
// Les modèles métier sont ajoutés module par module (une unité verticale = un domaine),
// jamais tous en une fois. Ce fichier ne contient pour l'instant que la configuration de base.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  // Nullable : les utilisateurs créés avant le domaine auth (seed, tests d'autres
  // domaines) n'ont pas de mot de passe tant qu'ils ne passent pas par /auth/register.
  // Jamais un PIN Mobile Money ni un identifiant bancaire — uniquement le mot de passe
  // du compte Finza lui-même.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Profil utilisé pour personnaliser l'assistant IA (voir module `ai`) : jamais requis à
  // l'inscription, chaque champ reste null tant que l'utilisateur ne l'a pas renseigné dans
  // son profil, et l'assistant doit le dire clairement plutôt que d'inventer une valeur.
  //
  // `country` n'est pas un enum Prisma délibérément : la liste des pays vit dans
  // @finza/config (COUNTRIES) pour pouvoir en ajouter sans migration ; la valeur est
  // validée contre cette liste au niveau du DTO, pas de la base.
  country             String?
  preferredLanguage   String              @default("fr")
  // Objectif principal tel que formulé par l'utilisateur (ex: "Épargner pour un terrain") —
  // texte libre plutôt qu'un enum, pour éviter de forcer une réponse générique.
  mainFinancialGoal   String?
  incomeFrequency     RevenueFrequency?
  financialSituation  FinancialSituation?

  accounts      Account[]
  categories    Category[]
  goals         Goal[]
  debts         Debt[]
  subscriptions Subscription[]
  reports       Report[]
  ownedFamilies Family[]      @relation("FamilyOwner")
  refreshTokens RefreshToken[]
  // Un utilisateur appartient à au plus une famille (FamilyMember.userId est unique) :
  // simplifie "quels comptes sont visibles" sans ambiguïté tant qu'il n'y a qu'un seul
  // foyer à gérer. Étendre à plusieurs familles resterait une évolution possible plus tard.
  familyMembership FamilyMember? @relation("FamilyMembership")

  @@map("users")
}

// Catégorise une source de revenus/dépenses gérée manuellement par l'utilisateur.
// Jamais un fournisseur externe (Mobile Money, banque) : uniquement une classification
// informative choisie par l'utilisateur lui-même.
enum RevenueCategory {
  salaire
  activite_professionnelle
  commerce
  freelance
  argent_de_poche
  revenu_secondaire
  autre
}

// À quelle cadence l'utilisateur s'attend à recevoir/saisir cette source de revenus.
// Purement descriptif : n'affecte jamais le calcul du solde (toujours reconstruit
// depuis AccountBalanceEntry), seulement l'affichage et les statistiques.
enum RevenueFrequency {
  daily
  weekly
  monthly
  quarterly
  yearly
  variable
}

// Auto-évaluation par l'utilisateur de sa situation financière générale — jamais déduite
// automatiquement des chiffres, uniquement ce qu'il déclare dans son profil. Sert de contexte
// qualitatif à l'assistant IA pour adapter son ton, pas de fait calculé.
enum FinancialSituation {
  stable
  tendue
  variable
  en_amelioration
}

// Un compte professionnel reste un compte comme un autre : c'est cette valeur qui le
// sépare du personnel, jamais visible par défaut aux autres membres en mode famille.
enum AccountOwnership {
  personal
  professional
}

// Source d'une écriture de solde : solde d'ouverture saisi à la création du compte,
// ou transaction enregistrée par le domaine Transactions.
enum BalanceEntrySource {
  opening
  transaction
}

// Une source d'argent suivie MANUELLEMENT par l'utilisateur (ex: "Salaire", "Commerce",
// "Argent de poche") — jamais connectée à un fournisseur externe (Mobile Money, banque).
// category/frequency ne sont que des métadonnées descriptives choisies par l'utilisateur ;
// le solde reste toujours reconstruit depuis AccountBalanceEntry, jamais depuis un tiers.
model Account {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  RevenueCategory
  frequency RevenueFrequency @default(monthly)
  ownership AccountOwnership @default(personal)

  // Code devise ISO (XOF, ...), validé côté service contre packages/config, jamais codé en dur ici.
  currency String

  // Cache dénormalisé pour l'affichage rapide. Ne fait jamais foi seul : toujours
  // reconstruit/vérifié à partir de AccountBalanceEntry (grand livre).
  currentBalance Decimal @default(0) @db.Decimal(18, 2)

  // false par défaut : un compte n'est jamais visible aux autres membres de la famille
  // sans action explicite du propriétaire (règle non négociable).
  isSharedWithFamily Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balanceEntries AccountBalanceEntry[]
  transactions   Transaction[]          @relation("SourceAccount")
  transfersIn    Transaction[]          @relation("TransferDestinationAccount")
  budgets        Budget[]
  goals          Goal[]
  debts          Debt[]
  subscriptions  Subscription[]

  @@index([userId])
  @@map("accounts")
}

// Grand livre append-only : permet de reconstituer le solde d'un compte à toute date.
model AccountBalanceEntry {
  id        String              @id @default(uuid())
  accountId String
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount    Decimal             @db.Decimal(18, 2)
  source    BalanceEntrySource
  note      String?
  effectiveAt DateTime
  createdAt DateTime            @default(now())

  @@index([accountId, effectiveAt])
  @@map("account_balance_entries")
}

enum CategoryKind {
  income
  expense
}

// userId null = catégorie système partagée (seedée depuis packages/config par pays).
// userId renseigné = catégorie personnalisée par l'utilisateur.
model Category {
  id        String       @id @default(uuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  label     String
  kind      CategoryKind
  createdAt DateTime     @default(now())

  transactions  Transaction[]
  budgets       Budget[]
  subscriptions Subscription[]

  @@unique([userId, key])
  @@map("categories")
}

enum TransactionType {
  income
  expense
  transfer
}

model Transaction {
  id        String          @id @default(uuid())
  accountId String
  account   Account         @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  type      TransactionType

  // Toujours positif : le sens (+/-) sur le solde du compte dépend de `type`.
  amount Decimal @db.Decimal(18, 2)

  // Requis pour income/expense (kind doit correspondre à type), absent pour transfer.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Requis uniquement pour type = transfer : compte de destination, doit appartenir
  // au même utilisateur et à la même devise que `account`.
  transferToAccountId String?
  transferToAccount   Account? @relation("TransferDestinationAccount", fields: [transferToAccountId], references: [id])

  description String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId, occurredAt])
  @@map("transactions")
}

// Budget mensuel récurrent pour une catégorie de dépense donnée sur un compte. Pas de
// champ de période : la progression est toujours calculée à la demande sur l'intervalle
// demandé (par défaut le mois courant), jamais stockée.
model Budget {
  id         String   @id @default(uuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  amount     Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accountId, categoryId])
  @@map("budgets")
}

// Objectif d'épargne. accountId est optionnel : un objectif peut être rattaché à un
// compte précis (ex: "épargner sur ce Wave") ou rester libre (suivi manuel uniquement).
// Comme pour les comptes, le montant atteint n'est jamais un simple compteur : toujours
// recalculé à partir de GoalContribution (grand livre append-only).
model Goal {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String?
  account      Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  name         String
  targetAmount Decimal   @db.Decimal(18, 2)
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contributions GoalContribution[]

  @@index([userId])
  @@map("goals")
}

model GoalContribution {
  id            String   @id @default(uuid())
  goalId        String
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(18, 2)
  note          String?
  contributedAt DateTime
  createdAt     DateTime @default(now())

  @@index([goalId, contributedAt])
  @@map("goal_contributions")
}

// "debt" = j'ai emprunté (je dois) ; "credit" = j'ai prêté (on me doit). Même domaine,
// deux directions, comme l'exige le modèle de données (dettes ET créances).
enum DebtDirection {
  debt
  credit
}

// Le solde restant n'est jamais un compteur : toujours recalculé à partir de DebtPayment
// (grand livre append-only), même principe que Account et Goal.
model Debt {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             DebtDirection
  counterpartyName String
  accountId        String?
  account          Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  principalAmount  Decimal       @db.Decimal(18, 2)
  dueDate          DateTime?
  description      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  payments DebtPayment[]

  @@index([userId])
  @@map("debts")
}

model DebtPayment {
  id      String   @id @default(uuid())
  debtId  String
  debt    Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount  Decimal  @db.Decimal(18, 2)
  note    String?
  paidAt  DateTime
  createdAt DateTime @default(now())

  @@index([debtId, paidAt])
  @@map("debt_payments")
}

enum BillingFrequency {
  weekly
  monthly
  quarterly
  yearly
}

// Un abonnement n'a pas de grand livre : contrairement aux comptes/objectifs/dettes, il
// n'y a rien à reconstituer, seulement une échéance qui avance à chaque renouvellement.
model Subscription {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String?
  account          Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  name             String
  amount           Decimal          @db.Decimal(18, 2)
  billingFrequency BillingFrequency
  nextBillingDate  DateTime
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

// Instantané figé des chiffres clés de l'utilisateur sur une période, agrégés depuis les
// autres domaines (comptes, revenus/dépenses, budgets, objectifs, dettes, abonnements).
// Contrairement à ces domaines, un rapport n'est jamais recalculé après coup : c'est un
// historique immuable (pas de mise à jour possible une fois généré).
model Report {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  periodStart DateTime
  periodEnd   DateTime
  generatedAt DateTime @default(now())
  snapshot    Json

  @@index([userId, generatedAt])
  @@map("reports")
}

model Family {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members FamilyMember[]

  @@map("families")
}

enum FamilyRole {
  owner
  member
}

// userId unique : voir le commentaire sur User.familyMembership — un utilisateur ne peut
// appartenir qu'à une seule famille dans ce MVP.
model FamilyMember {
  id       String     @id @default(uuid())
  familyId String
  family   Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId   String     @unique
  user     User       @relation("FamilyMembership", fields: [userId], references: [id], onDelete: Cascade)
  role     FamilyRole
  joinedAt DateTime   @default(now())

  @@map("family_members")
}

// Jeton opaque (pas un JWT) : permet la révocation réelle en base, contrairement à un JWT
// stateless qu'on ne peut qu'attendre d'expirer. Seul le hash est stocké, jamais le jeton
// en clair — comme pour un mot de passe.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}
