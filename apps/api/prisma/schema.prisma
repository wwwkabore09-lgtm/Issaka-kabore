// Schéma Prisma de Finza.
// Les modèles métier sont ajoutés module par module (une unité verticale = un domaine),
// jamais tous en une fois. Ce fichier ne contient pour l'instant que la configuration de base.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User minimal : uniquement ce qu'il faut pour la relation de propriété des comptes.
// L'authentification (JWT, refresh tokens, mot de passe/OTP) est un domaine séparé,
// pas encore implémenté.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts   Account[]
  categories Category[]

  @@map("users")
}

enum AccountType {
  orange_money
  moov_money
  mtn_money
  wave
  bank_account
  bank_card
  cash
}

// Un compte professionnel reste un compte comme un autre : c'est cette valeur qui le
// sépare du personnel, jamais visible par défaut aux autres membres en mode famille.
enum AccountOwnership {
  personal
  professional
}

// Source d'une écriture de solde : solde d'ouverture saisi à la création du compte,
// ou transaction enregistrée par le domaine Transactions.
enum BalanceEntrySource {
  opening
  transaction
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      AccountType
  ownership AccountOwnership @default(personal)

  // Code devise ISO (XOF, ...), validé côté service contre packages/config, jamais codé en dur ici.
  currency String

  // Cache dénormalisé pour l'affichage rapide. Ne fait jamais foi seul : toujours
  // reconstruit/vérifié à partir de AccountBalanceEntry (grand livre).
  currentBalance Decimal @default(0) @db.Decimal(18, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balanceEntries AccountBalanceEntry[]
  transactions   Transaction[]          @relation("SourceAccount")
  transfersIn    Transaction[]          @relation("TransferDestinationAccount")

  @@index([userId])
  @@map("accounts")
}

// Grand livre append-only : permet de reconstituer le solde d'un compte à toute date.
model AccountBalanceEntry {
  id        String              @id @default(uuid())
  accountId String
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount    Decimal             @db.Decimal(18, 2)
  source    BalanceEntrySource
  note      String?
  effectiveAt DateTime
  createdAt DateTime            @default(now())

  @@index([accountId, effectiveAt])
  @@map("account_balance_entries")
}

enum CategoryKind {
  income
  expense
}

// userId null = catégorie système partagée (seedée depuis packages/config par pays).
// userId renseigné = catégorie personnalisée par l'utilisateur.
model Category {
  id        String       @id @default(uuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  label     String
  kind      CategoryKind
  createdAt DateTime     @default(now())

  transactions Transaction[]

  @@unique([userId, key])
  @@map("categories")
}

enum TransactionType {
  income
  expense
  transfer
}

model Transaction {
  id        String          @id @default(uuid())
  accountId String
  account   Account         @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  type      TransactionType

  // Toujours positif : le sens (+/-) sur le solde du compte dépend de `type`.
  amount Decimal @db.Decimal(18, 2)

  // Requis pour income/expense (kind doit correspondre à type), absent pour transfer.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Requis uniquement pour type = transfer : compte de destination, doit appartenir
  // au même utilisateur et à la même devise que `account`.
  transferToAccountId String?
  transferToAccount   Account? @relation("TransferDestinationAccount", fields: [transferToAccountId], references: [id])

  description String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId, occurredAt])
  @@map("transactions")
}
